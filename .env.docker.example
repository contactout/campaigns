# Copy to .env and edit before `docker compose up`.
#   cp .env.docker.example .env

APP_NAME=Campaigns
APP_ENV=production
# Required — generate with: echo "base64:$(openssl rand -base64 32)"
APP_KEY=
APP_DEBUG=false
APP_URL=https://mail.example.com

# Public sign-up. The first user can always register; when false, everyone else
# joins through a team invitation. Set to true only if you want open sign-up.
REGISTRATION_ENABLED=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# --- Docker Compose / Caddy ---
DOMAIN=mail.example.com
ACME_EMAIL=admin@example.com
# Host ports published by Caddy (container still uses 80/443).
# Change these when 80/443 are already taken (e.g. local Herd/nginx).
HTTP_PORT=80
HTTPS_PORT=443
# If HTTPS_PORT is not 443, include it in APP_URL, e.g. https://localhost:8443

# --- Database (MySQL service) ---
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=campaigns
DB_USERNAME=campaigns
DB_PASSWORD=change-me-strong-password
DB_ROOT_PASSWORD=change-me-root-password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# --- System mail ---
# Email verification, password resets and team invitations are sent through this
# mailer and need a working one. With the default "log" mailer nothing is
# delivered, so new users cannot verify their email. Configure SMTP below, or as
# an escape hatch verify a user manually:
#   docker compose exec app php artisan campaigns:verify-user you@example.com
MAIL_MAILER=log
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_USERNAME=your-smtp-username
# MAIL_PASSWORD=your-smtp-password
# MAIL_SCHEME=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Optional — Gmail / Outlook OAuth (Connect buttons appear when set)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/oauth/google/callback"

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI="${APP_URL}/oauth/microsoft/callback"
MICROSOFT_TENANT=common
